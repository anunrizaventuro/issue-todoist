# Copy to `.dev.vars` for local development (`wrangler dev`).
# `.dev.vars` is gitignored — never commit real values.
# For production, use: wrangler secret put <NAME>

# Discord → Developer Portal → your app → General Information → Public Key
DISCORD_PUBLIC_KEY=

# Anthropic → console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Todoist → Settings → Integrations → Developer → API token
TODOIST_API_TOKEN=

# Comma-separated Discord server IDs allowed to use the commands.
# Leave empty to allow any guild (development only).
ALLOWED_GUILD_IDS=

# Only used by `npm run register` (never read by the Worker).
# Discord → Developer Portal → Bot → Reset Token
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
